      "evaluation_call": "最后,进去,然后进去。",
      "direct_call": "最后,进去,然后进去。"
    },
    {
      "id": 24,
      "source": "Bola uxlayapti.",
      "reference": "孩子正在睡觉。",
      "evaluation_call": "会摔倒",
      "direct_call": "会摔倒"
    },
    {
      "id": 25,
      "source": "Men har kuni ishga avtobusda boraman.",
