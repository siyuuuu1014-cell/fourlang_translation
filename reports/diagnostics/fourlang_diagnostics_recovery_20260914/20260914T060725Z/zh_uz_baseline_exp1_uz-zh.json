      "evaluation_call": "最后,我只有一瓶水瓶。",
      "direct_call": "最后,我只有一瓶水瓶。"
    },
    {
      "id": 4,
      "source": "Bu kitob qancha turadi?",
      "reference": "这本书多少钱？",
      "evaluation_call": "这本书有多好呢?",
      "direct_call": "这本书有多好呢?"
    },
    {
      "id": 5,
      "source": "Men uchta olma sotib oldim.",
      "reference": "我买了三个苹果。",
      "evaluation_call": "我买了三个人",
      "direct_call": "我买了三个人"
    },
    {
      "id": 6,
      "source": "U kecha menga telefon qildi.",
