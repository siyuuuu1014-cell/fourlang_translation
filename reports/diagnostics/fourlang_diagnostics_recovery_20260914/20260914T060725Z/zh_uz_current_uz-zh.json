  "rows": [
    {
      "id": 1,
      "source": "Uchrashuv soat to'qqizda boshlanadi.",
      "reference": "会议九点开始。",
      "evaluation_call": "收听始于八点钟.",
      "direct_call": "收听始于八点钟."
    },
    {
      "id": 2,
      "source": "Men bugun maktabga bormayman.",
      "reference": "我今天不去学校。",
      "evaluation_call": "今天我不在学校.",
      "direct_call": "今天我不在学校."
    },
    {
      "id": 3,
      "source": "Iltimos, menga bir stakan suv bering.",
      "reference": "请给我一杯水。",
      "evaluation_call": "请给我一杯水.",
      "direct_call": "请给我一杯水."
    },
    {
      "id": 4,
      "source": "Bu kitob qancha turadi?",
      "reference": "这本书多少钱？",
      "evaluation_call": "这本书有多少?",
      "direct_call": "这本书有多少?"
    },
    {
      "id": 5,
      "source": "Men uchta olma sotib oldim.",
      "reference": "我买了三个苹果。",
      "evaluation_call": "我买了三个人.",
      "direct_call": "我买了三个人."
    },
    {
      "id": 6,
      "source": "U kecha menga telefon qildi.",
      "reference": "他昨天给我打了电话。",
      "evaluation_call": "他打电话给我.",
      "direct_call": "他打电话给我."
    },
    {
      "id": 7,
      "source": "Biz ertaga ertalab yo'lga chiqamiz.",
      "reference": "我们明天早上出发。",
      "evaluation_call": "我们很快就开始了.",
      "direct_call": "我们很快就开始了."
    },
    {
      "id": 8,
      "source": "Iltimos, derazani ochmang.",
      "reference": "请不要打开窗户。",
      "evaluation_call": "请不要打开门.",
      "direct_call": "请不要打开门."
    },
    {
      "id": 9,
      "source": "Shifoxona bank yonida joylashgan.",
      "reference": "医院在银行旁边。",
      "evaluation_call": "位于Shifoxona银行.",
      "direct_call": "位于Shifoxona银行."
    },
    {
      "id": 10,
      "source": "Men kalitni uyda unutib qoldirdim.",
      "reference": "我把钥匙忘在家里了。",
      "evaluation_call": "我忘记了房子.",
      "direct_call": "我忘记了房子."
    },
    {
      "id": 11,
      "source": "Agar yomg'ir yog'sa, biz bog'ga bormaymiz.",
      "reference": "如果下雨，我们就不去公园。",
      "evaluation_call": "如果有火,我们就不会陷入困境.",
      "direct_call": "如果有火,我们就不会陷入困境."
    },
    {
      "id": 12,
      "source": "Men Toshkentga chipta sotib olmoqchiman.",
      "reference": "我想买一张去塔什干的车票。",
      "evaluation_call": "我可以买到塔什干的芯片.",
      "direct_call": "我可以买到塔什干的芯片."
    },
    {
      "id": 13,
      "source": "Poyezd tushdan keyin soat 3 da yetib keladi.",
      "reference": "火车下午3点到达。",
      "evaluation_call": "火车在下午3点左右抵达.",
      "direct_call": "火车在下午3点左右抵达."
    },
    {
      "id": 14,
      "source": "Bu xonada issiq suv yo'q.",
      "reference": "这个房间没有热水。",
      "evaluation_call": "这里没有热水.",
      "direct_call": "这里没有热水."
    },
    {
      "id": 15,
      "source": "Iltimos, manzilni menga yuboring.",
      "reference": "请把地址发给我。",
      "evaluation_call": "请给我发送地址.",
      "direct_call": "请给我发送地址."
    },
    {
      "id": 16,
      "source": "Men allaqachon nonushta qildim.",
      "reference": "我已经吃过早饭了。",
      "evaluation_call": "我已经失败了.",
      "direct_call": "我已经失败了."
    },
    {
      "id": 17,
      "source": "U hali qaytib kelmadi.",
      "reference": "他还没有回来。",
      "evaluation_call": "他还没有回来.",
      "direct_call": "他还没有回来."
    },
    {
      "id": 18,
      "source": "Bu mening telefonim emas.",
      "reference": "这不是我的手机。",
      "evaluation_call": "这不是我的电话.",
      "direct_call": "这不是我的电话."
    },
    {
      "id": 19,
      "source": "Iltimos, sekinroq gapiring.",
      "reference": "请慢一点说。",
      "evaluation_call": "让我们更轻松地说一下.",
      "direct_call": "让我们更轻松地说一下."
    },
    {
      "id": 20,
      "source": "Men bu gapni tushunmayapman.",
      "reference": "我听不懂这句话。",
      "evaluation_call": "我不懂这个说法.",
      "direct_call": "我不懂这个说法."
    },
    {
      "id": 21,
      "source": "Biz o'n daqiqa kutishimiz kerak.",
      "reference": "我们需要等十分钟。",
      "evaluation_call": "我们需要一分钟的跑步.",
      "direct_call": "我们需要一分钟的跑步."
    },
    {
      "id": 22,
      "source": "Do'kon kechqurun soat sakkizda yopiladi.",
      "reference": "商店晚上八点关门。",
      "evaluation_call": "门店在晚上八点关闭.",
      "direct_call": "门店在晚上八点关闭."
    },
    {
      "id": 23,
      "source": "Iltimos, chapga buriling, keyin to'g'ri yuring.",
      "reference": "请向左转，然后一直走。",
      "evaluation_call": "让我们走进门,然后走进门.",
      "direct_call": "让我们走进门,然后走进门."
    },
    {
      "id": 24,
      "source": "Bola uxlayapti.",
      "reference": "孩子正在睡觉。",
      "evaluation_call": "他会死去.",
      "direct_call": "他会死去."
    },
    {
      "id": 25,
      "source": "Men har kuni ishga avtobusda boraman.",
      "reference": "我每天坐公交车上班。",
      "evaluation_call": "我每天都在公共汽车上班.",
      "direct_call": "我每天都在公共汽车上班."
    },
    {
