      "source": "Bu kiyim juda katta.",
      "reference": "这件衣服太大了。",
      "evaluation_call": "这件衣服太大了.",
      "direct_call": "这件衣服太大了."
    },
    {
      "id": 27,
      "source": "Menga faqat ikkita chipta kerak.",
      "reference": "我只需要两张票。",
      "evaluation_call": "我只需要两个芯片.",
      "direct_call": "我只需要两个芯片."
    },
    {
      "id": 28,
      "source": "Iltimos, avval qo'lingizni yuving, keyin ovqatlaning.",
